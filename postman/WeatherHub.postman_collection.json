{
  "info": {
    "_postman_id": "7b708b5e-77fb-4cce-a31a-274637f92031",
    "name": "WeatherHub API",
    "description": "WeatherHub backend API scenarios. Weather requests require OPENWEATHER_API_KEY in the running backend. Favorite write requests modify the configured weatherhub_db; use a disposable test database when exercising them.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:5000"
    },
    {
      "key": "city",
      "value": "Vijayawada"
    },
    {
      "key": "country",
      "value": "IN"
    },
    {
      "key": "invalidCity",
      "value": "WeatherHubUnknownCity987654321"
    },
    {
      "key": "favoriteId",
      "value": ""
    },
    {
      "key": "conflictCity",
      "value": ""
    },
    {
      "key": "updatedCity",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check (200)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returns 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Returns healthy status', function () { pm.expect(pm.response.json().data.status).to.eql('healthy'); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Weather",
      "item": [
        {
          "name": "Current weather (200)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/weather/current?city={{city}}&country={{country}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returns 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Contains weather data', function () { pm.expect(pm.response.json().data).to.be.an('object'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Current weather missing parameters (400)",
